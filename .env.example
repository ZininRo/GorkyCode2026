# Copy to .env for local development. Do NOT commit .env.
POSTGRES_DB=gorkycode2026
POSTGRES_USER=backend
POSTGRES_PASSWORD=local_dev_password_change_me
POSTGRES_PORT=5432
APP_PORT=8080

# Mandatory: generate a new Base64-encoded random secret (at least 32 bytes).
# PowerShell 5.1+: $b = New-Object byte[] 32; $r=[Security.Cryptography.RandomNumberGenerator]::Create(); $r.GetBytes($b); [Convert]::ToBase64String($b); $r.Dispose()
# macOS/Linux: openssl rand -base64 32
AUTH_JWT_SECRET=REPLACE_WITH_GENERATED_BASE64_SECRET
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# --- MVP quest (game, owner: Юля) ---
# Local demo requires SPRING_PROFILES_ACTIVE=local-demo and GAME_DEMO_MODE=true.
SPRING_PROFILES_ACTIVE=
GAME_DEMO_MODE=false
GAME_COLLECT_RADIUS_METERS=100
GAME_MAX_GPS_ACCURACY_METERS=100

# --- AI hints/recommendations (owner: Рома): YandexGPT via the Yandex Cloud OpenAI-compatible API ---
# See YANDEX_SETUP_GUIDE.md. With AI_ENABLED=false or an empty key the API returns verified fallback texts.
# Replace <FOLDER_ID> and <YANDEX_API_KEY>; never commit real keys (.env is in .gitignore).
AI_ENABLED=false
AI_BASE_URL=https://llm.api.cloud.yandex.net/v1
AI_API_KEY=<YANDEX_API_KEY>
AI_MODEL=gpt://<FOLDER_ID>/yandexgpt/latest
AI_PROJECT=<FOLDER_ID>
AI_TIMEOUT_SECONDS=15
# For OpenAI instead: AI_BASE_URL=https://api.openai.com/v1, AI_MODEL=gpt-4o-mini, AI_PROJECT= (empty)
