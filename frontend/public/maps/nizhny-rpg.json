    {"id":"parks","type":"fill","source":"openmaptiles","source-layer":"park","paint":{"fill-color":"#93b677","fill-outline-color":"#728f53","fill-pattern":"gorky-park-pattern","fill-opacity":0.83}},
    {"id":"water-shadow","type":"line","source":"openmaptiles","source-layer":"water","paint":{"line-color":"#769a83","line-width":5,"line-opacity":0.7}},
    {"id":"water","type":"fill","source":"openmaptiles","source-layer":"water","paint":{"fill-color":"#74b9cb","fill-outline-color":"#548fa6"}},
    {"id":"streams","type":"line","source":"openmaptiles","source-layer":"waterway","paint":{"line-color":"#6bb3c7","line-width":2}},
