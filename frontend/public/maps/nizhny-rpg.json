    {"id":"street-names","type":"symbol","source":"openmaptiles","source-layer":"transportation_name","minzoom":15,"layout":{"symbol-placement":"line","text-field":["coalesce",["get","name:ru"],["get","name"]],"text-font":["Noto Sans Regular"],"text-size":11},"paint":{"text-color":"#67553a","text-halo-color":"#f8ecd2","text-halo-width":1}}
