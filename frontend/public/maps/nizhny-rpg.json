    {"id":"road-outline","type":"line","source":"openmaptiles","source-layer":"transportation","filter":["in",["get","class"],["literal",["motorway","trunk","primary","secondary","tertiary","minor","service"]]],"layout":{"line-cap":"square","line-join":"bevel"},"paint":{"line-color":"#a58864","line-width":["interpolate",["linear"],["zoom"],10,2,14,5,18,17]}},
    {"id":"roads","type":"line","source":"openmaptiles","source-layer":"transportation","filter":["in",["get","class"],["literal",["motorway","trunk","primary","secondary","tertiary","minor","service"]]],"layout":{"line-cap":"square","line-join":"bevel"},"paint":{"line-color":["match",["get","class"],["motorway","trunk","primary"],"#f9e8a9","#f8ecd2"],"line-width":["interpolate",["linear"],["zoom"],10,1,14,3,18,14]}},
    {"id":"paths","type":"line","source":"openmaptiles","source-layer":"transportation","minzoom":14,"filter":["in",["get","class"],["literal",["path","track"]]],"paint":{"line-color":"#887956","line-width":1.5,"line-dasharray":[2,2]}},
